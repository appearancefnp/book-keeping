{
  "name": "bookkeeping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file=.env --import tsx src/dev/seed.ts",
    "provision-admin": "node --env-file=.env --import tsx src/dev/provision-admin.ts",
    "worker": "node --env-file=.env --import tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "fast-xml-parser": "^4.5.6",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
